{
  "name": "collective-stock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run assets:build && npm run assets:validate && npm run css:build && vite build && node scripts/copy-public-assets.js && node scripts/generate-static-routes.js && npm run verify:dist",
    "preview": "vite preview --host 0.0.0.0",
    "css:build": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/generated.css --minify",
    "assets:manifest": "node scripts/build-asset-manifest.js",
    "assets:build": "npm run assets:materialize && node scripts/generate-divisions.js && node scripts/optimize-images.js && node scripts/generate-posters.js && node scripts/build-asset-manifest.js && node scripts/generate-search-index.js && node scripts/generate-sitemap.js",
    "assets:materialize": "node scripts/materialize-google-photos-album.js",
    "assets:album:package": "node scripts/package-google-photos-archive.js",
    "assets:album:audit": "node scripts/audit-google-photos-album.js",
    "assets:album:ingest": "node scripts/ingest-google-photos-album.js",
    "assets:optimize": "node scripts/optimize-images.js",
    "assets:validate": "node scripts/validate-assets.js",
    "verify:dist": "node scripts/verify-dist.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run assets:build && npm run test && npm run build"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@playwright/test": "^1.54.2",
    "@sparticuz/chromium": "^149.0.0",
    "autoprefixer": "^10.4.21",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "yauzl": "^3.2.0"
  }
}
